<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpotifyTaskbarWidget</RootNamespace>
    <AssemblyName>SpotifyTaskbarWidget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.4.0</Version>
    <Product>Now Playing - Taskbar Widget</Product>
    <AssemblyTitle>Now Playing - Taskbar Widget</AssemblyTitle>
    <Company>MechanicWB</Company>
    <!-- Um único .exe no publish, para as atualizações substituírem só um ficheiro -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- WPF's mixed-mode assemblies need to load from disk (dotnet/wpf#11842). -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
